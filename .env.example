# Aster & Row AI Support Agent Environment Configuration

# Provider selection: "groq", "mock" (offline deterministic), "openai", or "gemini"
LLM_PROVIDER=groq

# Model selection
GROQ_MODEL=openai/gpt-oss-120b
OPENAI_MODEL=gpt-4o-mini
GEMINI_MODEL=gemini-1.5-flash

# API Keys (leave blank if running in offline deterministic mock mode)
GROQ_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Server Configuration
PORT=8000
HOST=0.0.0.0
DEBUG=false
